                    <TablixCell>
                      <CellContents>
                        <Textbox Name="TotalAmount">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(Fields!Quantity.Value * Fields!UnitPrice.Value)</Value>
                                  <Style>
                                    <FontFamily>Liberation Sans</FontFamily>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>F2</Format>
                                  </Style>
