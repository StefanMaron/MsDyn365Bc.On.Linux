            <Top>0in</Top>
            <Left>0in</Left>
            <Height>0.4in</Height>
            <Width>6in</Width>
            <Style />
          </Textbox>
          <Textbox Name="CodeResult">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Code.Note()</Value>
                    <Style>
                      <FontFamily>Liberation Sans</FontFamily>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0.5in</Top>
            <Left>0in</Left>
            <Height>0.3in</Height>
            <Width>6in</Width>
